# PayStream Reliability Lab - pinned versions and non-secret defaults
# Copy to .env for local runs: cp .env.example .env
# .env is git-ignored; never commit real secrets.
#
# WP0.1 baseline (23.6 GB RAM workstation, 62 GB free disk):
# broker heap 1 GB x3, Schema Registry 512 MB, services 512 MB - total JVM
# footprint approx. 6.5 GB with monitoring stack, within the 16 GB reference.

# ---- Core streaming platform (pinned; never use "latest") ----
KAFKA_IMAGE=apache/kafka:4.0.0
SCHEMA_REGISTRY_IMAGE=confluentinc/cp-schema-registry:7.9.0
POSTGRES_IMAGE=postgres:16-alpine

# Kafka KRaft cluster identity (fixed so volumes are reproducible)
CLUSTER_ID=p95bOgLPRsyAPBXb13tBEw

# ---- JVM heap sizes (WP0.1 measurements, see docs/operations/deployment-guide.md) ----
KAFKA_HEAP_OPTS=-Xmx1g -Xms1g
SCHEMA_REGISTRY_HEAP_OPTS=-Xmx512m -Xms256m
SERVICE_JAVA_OPTS=-Xmx512m

# ---- Application workload ----
TXN_PRODUCER_RATE_PER_SECOND=100
FRAUD_AMOUNT_THRESHOLD=10000
ACCOUNT_POOL_SIZE=200

# ---- Ports (host) ----
KAFKA_1_HOST_PORT=19091
KAFKA_2_HOST_PORT=19092
KAFKA_3_HOST_PORT=19093
SCHEMA_REGISTRY_HOST_PORT=8081
POSTGRES_HOST_PORT=5433
TXN_PRODUCER_HOST_PORT=8080
FRAUD_DETECTOR_HOST_PORT=8082
NOTIFIER_HOST_PORT=8083
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
ALERTMANAGER_HOST_PORT=9093

# ---- PostgreSQL (lab credentials; Stage 3 moves these to Vault/sealed secrets) ----
POSTGRES_DB=paystream
POSTGRES_USER=paystream
POSTGRES_PASSWORD=paystream

# ---- Observability images (pinned) ----
PROMETHEUS_IMAGE=prom/prometheus:v3.4.1
GRAFANA_IMAGE=grafana/grafana:12.0.0
ALERTMANAGER_IMAGE=prom/alertmanager:v0.28.1

# ---- Service images (built locally) ----
TXN_PRODUCER_IMAGE=paystream/txn-producer:0.1.0
FRAUD_DETECTOR_IMAGE=paystream/fraud-detector:0.1.0
NOTIFIER_IMAGE=paystream/notifier:0.1.0

# ---- Stage 2 additions (WP2.1/WP2.2/WP2.4/WP2.5) ----
# Security (make certs / make scram generate the real material)
KAFKA_SSL_PASSWORD=paystream-lab
KAFKA_BROKER_HOST_PORT=19094

# Kafka Connect (CDC)
CONNECT_IMAGE=confluentinc/cp-kafka-connect:7.9.0
CONNECT_HOST_PORT=18083

# Observability images (pinned)
PUSHGATEWAY_IMAGE=prom/pushgateway:v1.11.0
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.9.1
LOKI_IMAGE=grafana/loki:3.4.2
PROMTAIL_IMAGE=grafana/promtail:3.4.2

# Observability ports
PUSHGATEWAY_HOST_PORT=9091
NODE_EXPORTER_HOST_PORT=9100
LOKI_HOST_PORT=3100
PROMTAIL_HOST_PORT=9080
