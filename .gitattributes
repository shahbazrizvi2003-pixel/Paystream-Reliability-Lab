# Line endings: the lab mounts bash scripts and YAML configs into containers
# (bootstrap-security.sh, apply-*.sh, prometheus/loki configs). Container-side
# POSIX tools and busybox bash choke on CRLF ("set: pipefail: invalid option
# name"), so everything textual is stored and checked out LF.
* text=auto eol=lf

# Windows-specific files keep CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets must never be normalized
*.jar binary
*.p12 binary
*.jks binary
*.class binary
